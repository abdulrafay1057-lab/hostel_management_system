<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1120" viewBox="0 0 1600 1120" role="img" aria-labelledby="title desc">
  <title id="title">Hostel Management System Integration Testing Diagram</title>
  <desc id="desc">Five integration test flows connect application approval to bed allotment, allotment to occupancy, complaint submission to staff dashboard, payment verification to student fee status, and visitor entry to resident record.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#53647b"/></marker>
    <style>
      text{font-family:Segoe UI,Arial,sans-serif;fill:#18263b}.title{font-size:38px;font-weight:700}.sub{font-size:19px;fill:#5d6b80}.head{font-size:19px;font-weight:700}.mod{font-size:20px;font-weight:650}.detail{font-size:16px;fill:#52627a}.lane{fill:#f7f9fc;stroke:#dce4ef;stroke-width:2}.system{fill:#eaf2ff;stroke:#5684cc;stroke-width:2}.arrow{stroke:#53647b;stroke-width:3;fill:none;marker-end:url(#arrow)}.tag{fill:#fff;stroke:#cdd7e4;stroke-width:1.5}
    </style>
  </defs>
  <rect width="1600" height="1120" fill="#fff"/>
  <text x="800" y="58" text-anchor="middle" class="title">Hostel Management System</text>
  <text x="800" y="92" text-anchor="middle" class="sub">4.2.2 Integration Testing — verify connected modules exchange data and update records correctly</text>
  <rect x="55" y="125" width="1490" height="72" rx="16" fill="#eef5f1" stroke="#73a98a" stroke-width="2"/>
  <text x="800" y="170" text-anchor="middle" class="head">Integration test flow: provide input → connect modules → verify resulting records and status</text>

  <!-- Lane 1 -->
  <rect x="55" y="225" width="1490" height="150" rx="18" class="lane"/>
  <text x="82" y="257" class="head">IT-01 · Approved application with bed allotment</text>
  <rect x="95" y="278" width="390" height="72" rx="13" class="system"/><text x="290" y="308" text-anchor="middle" class="mod">Application Management</text><text x="290" y="333" text-anchor="middle" class="detail">Approve eligible student application</text>
  <path d="M495 314 H715" class="arrow"/><rect x="525" y="281" width="160" height="27" rx="12" class="tag"/><text x="605" y="300" text-anchor="middle" class="detail">approved student + needs</text>
  <rect x="730" y="278" width="330" height="72" rx="13" class="system"/><text x="895" y="308" text-anchor="middle" class="mod">Bed Allotment</text><text x="895" y="333" text-anchor="middle" class="detail">Select and assign available bed</text>
  <path d="M1070 314 H1285" class="arrow"/><rect x="1096" y="281" width="158" height="27" rx="12" class="tag"/><text x="1175" y="300" text-anchor="middle" class="detail">bed assignment</text>
  <rect x="1300" y="278" width="205" height="72" rx="13" class="system"/><text x="1402" y="308" text-anchor="middle" class="mod">Student Record</text><text x="1402" y="333" text-anchor="middle" class="detail">allotment saved</text>

  <!-- Lane 2 -->
  <rect x="55" y="392" width="1490" height="150" rx="18" class="lane"/>
  <text x="82" y="424" class="head">IT-02 · Bed allotment with occupancy update</text>
  <rect x="95" y="445" width="390" height="72" rx="13" class="system"/><text x="290" y="475" text-anchor="middle" class="mod">Bed Allotment</text><text x="290" y="500" text-anchor="middle" class="detail">Confirm assignment to resident</text>
  <path d="M495 481 H715" class="arrow"/><rect x="525" y="448" width="160" height="27" rx="12" class="tag"/><text x="605" y="467" text-anchor="middle" class="detail">bed ID + active status</text>
  <rect x="730" y="445" width="330" height="72" rx="13" class="system"/><text x="895" y="475" text-anchor="middle" class="mod">Occupancy Management</text><text x="895" y="500" text-anchor="middle" class="detail">Update occupied/vacant count</text>
  <path d="M1070 481 H1285" class="arrow"/><rect x="1095" y="448" width="160" height="27" rx="12" class="tag"/><text x="1175" y="467" text-anchor="middle" class="detail">updated occupancy</text>
  <rect x="1300" y="445" width="205" height="72" rx="13" class="system"/><text x="1402" y="475" text-anchor="middle" class="mod">Room / Bed View</text><text x="1402" y="500" text-anchor="middle" class="detail">count reflects assignment</text>

  <!-- Lane 3 -->
  <rect x="55" y="559" width="1490" height="150" rx="18" class="lane"/>
  <text x="82" y="591" class="head">IT-03 · Complaint submission with staff dashboard</text>
  <rect x="95" y="612" width="390" height="72" rx="13" class="system"/><text x="290" y="642" text-anchor="middle" class="mod">Resident Complaint Portal</text><text x="290" y="667" text-anchor="middle" class="detail">Submit complaint and category</text>
  <path d="M495 648 H715" class="arrow"/><rect x="525" y="615" width="160" height="27" rx="12" class="tag"/><text x="605" y="634" text-anchor="middle" class="detail">complaint + priority</text>
  <rect x="730" y="612" width="330" height="72" rx="13" class="system"/><text x="895" y="642" text-anchor="middle" class="mod">Complaint Management</text><text x="895" y="667" text-anchor="middle" class="detail">Store and assign complaint</text>
  <path d="M1070 648 H1285" class="arrow"/><rect x="1096" y="615" width="158" height="27" rx="12" class="tag"/><text x="1175" y="634" text-anchor="middle" class="detail">new assigned item</text>
  <rect x="1300" y="612" width="205" height="72" rx="13" class="system"/><text x="1402" y="642" text-anchor="middle" class="mod">Staff Dashboard</text><text x="1402" y="667" text-anchor="middle" class="detail">complaint is visible</text>

  <!-- Lane 4 -->
  <rect x="55" y="726" width="1490" height="150" rx="18" class="lane"/>
  <text x="82" y="758" class="head">IT-04 · Payment verification with student fee status</text>
  <rect x="95" y="779" width="390" height="72" rx="13" class="system"/><text x="290" y="809" text-anchor="middle" class="mod">Payment Gateway</text><text x="290" y="834" text-anchor="middle" class="detail">Return verified transaction event</text>
  <path d="M495 815 H715" class="arrow"/><rect x="525" y="782" width="160" height="27" rx="12" class="tag"/><text x="605" y="801" text-anchor="middle" class="detail">verified result + amount</text>
  <rect x="730" y="779" width="330" height="72" rx="13" class="system"/><text x="895" y="809" text-anchor="middle" class="mod">Fee / Payment Service</text><text x="895" y="834" text-anchor="middle" class="detail">Validate and post payment</text>
  <path d="M1070 815 H1285" class="arrow"/><rect x="1096" y="782" width="158" height="27" rx="12" class="tag"/><text x="1175" y="801" text-anchor="middle" class="detail">paid / due balance</text>
  <rect x="1300" y="779" width="205" height="72" rx="13" class="system"/><text x="1402" y="809" text-anchor="middle" class="mod">Student Fee Record</text><text x="1402" y="834" text-anchor="middle" class="detail">status and balance updated</text>

  <!-- Lane 5 -->
  <rect x="55" y="893" width="1490" height="150" rx="18" class="lane"/>
  <text x="82" y="925" class="head">IT-05 · Visitor entry with resident record</text>
  <rect x="95" y="946" width="390" height="72" rx="13" class="system"/><text x="290" y="976" text-anchor="middle" class="mod">Visitor Log</text><text x="290" y="1001" text-anchor="middle" class="detail">Record visitor and resident reference</text>
  <path d="M495 982 H715" class="arrow"/><rect x="525" y="949" width="160" height="27" rx="12" class="tag"/><text x="605" y="968" text-anchor="middle" class="detail">resident ID lookup</text>
  <rect x="730" y="946" width="330" height="72" rx="13" class="system"/><text x="895" y="976" text-anchor="middle" class="mod">Resident Records</text><text x="895" y="1001" text-anchor="middle" class="detail">Confirm resident identity / room</text>
  <path d="M1070 982 H1285" class="arrow"/><rect x="1095" y="949" width="160" height="27" rx="12" class="tag"/><text x="1175" y="968" text-anchor="middle" class="detail">validated visit link</text>
  <rect x="1300" y="946" width="205" height="72" rx="13" class="system"/><text x="1402" y="976" text-anchor="middle" class="mod">Visit Record</text><text x="1402" y="1001" text-anchor="middle" class="detail">entry linked to resident</text>

  <text x="800" y="1080" text-anchor="middle" class="sub">Verify successful data flow, correct record updates, and appropriate error handling at each module boundary.</text>
</svg>
